# ============================================================
# 週末戰士 — 環境變數範本
# 使用方式：複製此檔為 .env，填入實際值，不要上傳到任何地方
# ============================================================

# ── 資料庫 ────────────────────────────────────────────────────
DB_NAME=weekend_warrior
DB_USER=ww_admin
DB_PASSWORD=請替換成強密碼_至少16字元

# ── 應用程式 ──────────────────────────────────────────────────
SECRET_KEY=請替換成隨機字串_用於JWT簽章
ENVIRONMENT=production

# ── 匯率 API (Open Exchange Rates 免費方案) ───────────────────
# 申請：https://openexchangerates.org/signup/free
FX_API_KEY=請填入API金鑰

# ── Cloudflare Tunnel ─────────────────────────────────────────
# 步驟：https://dash.cloudflare.com → Zero Trust → Tunnels → 新增 Tunnel
# 取得 Token 後貼在下方
CLOUDFLARE_TUNNEL_TOKEN=請填入Cloudflare_Tunnel_Token
