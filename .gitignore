# ============================================================
# 週末戰士 — .gitignore
# ⚠️  重要：.env 含機密資訊，絕對不能上傳到 GitHub
# ============================================================

# ── 機密設定（絕對不上傳）──────────────────────────────────────
.env
*.env.local
secrets/

# ── 資料庫與上傳資料（本機資料，不納入版控）──────────────────────
data/
uploads/
exports/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# ── 系統檔案 ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.tmp

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.xlsx
*.csv
